cabal-version:      3.4
name:               assetdb-ai
version:            0.1.0.0
synopsis:           Alchbees 資源管理系統 — 離線 LLM 分類與標註
description:
  以本機 llama.cpp(OpenAI 相容端點)對素材做離線分類與標註。
  輸出一律先進 ai_suggestions 待確認,確認後才寫入 tags / asset_tags /
  asset_categories —— 與 cluster rule 的 --confirm 閘門同一個模式。
  .
  LLM 沒開時所有函式回傳 Left,不拋例外:伺服器不該因為推論服務沒啟動而掛掉。

license:            BSD-3-Clause
author:             Alchbees Studio
maintainer:         lhm.stu@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat

library
    import:           warnings
    exposed-modules:
        AssetDB.AI.Llm
        AssetDB.AI.Schema
        AssetDB.AI.Vocab
        AssetDB.AI.Prompt
        AssetDB.AI.Image
        AssetDB.AI.Suggest
        AssetDB.AI.Run
        AssetDB.AI.Classify
        AssetDB.AI.Vision
        AssetDB.AI.Query
    hs-source-dirs:   src
    build-depends:
        , assetdb-core
        , assetdb-store
        , aeson              >=2.1  && <2.3
        , base               >=4.17 && <5
        , base64-bytestring  >=1.2
        , bytestring         >=0.11
        , containers         >=0.6
        , directory          >=1.3
        , filepath           >=1.4
        , http-client        >=0.7
        , http-types         >=0.12
        , sqlite-simple      >=0.4.18
        , text               >=2.0
        , time               >=1.12
    default-language: GHC2021
    default-extensions:
        DerivingStrategies
        LambdaCase
        OverloadedStrings
        RecordWildCards
        StrictData

test-suite assetdb-ai-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:
        AssetDB.AI.LlmSpec
        AssetDB.AI.SchemaSpec
        AssetDB.AI.PromptSpec
        AssetDB.AI.SuggestSpec
        AssetDB.AI.RunSpec
    hs-source-dirs:   test
    build-depends:
        , assetdb-ai
        , assetdb-core
        , assetdb-store
        , aeson
        , base
        , bytestring
        , containers
        , hspec          >=2.10
        , sqlite-simple
        , text
    build-tool-depends: hspec-discover:hspec-discover
    default-language: GHC2021
    default-extensions:
        LambdaCase
        OverloadedStrings
        RecordWildCards
