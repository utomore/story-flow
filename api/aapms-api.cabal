cabal-version:      3.4
name:               aapms-api
version:            0.1.0.0
synopsis:           aapms 的 servant API 契約(只有型別)
license:            BSD-3-Clause
author:             Alchbees Studio
maintainer:         lhm.stu@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat

common lang
    default-language:   GHC2021
    default-extensions:
        DataKinds
        DerivingStrategies
        LambdaCase
        OverloadedStrings
        RecordWildCards
        StrictData
        TypeOperators

library
    import:           warnings, lang
    hs-source-dirs:   src
    exposed-modules:
        Aapms.Api
        Aapms.Api.Instances
    -- service-and-interfaces/F003 驗收:這個套件是 server 與 cli --remote 共用的契約,
    -- 因此它不能認得任何一個實作端。servant-server / servant-client / warp /
    -- aapms-store 出現在這裡即為架構違規(service-and-interfaces/F003 T1 的測試會擋下來)。
    --
    -- conflict-detection/F004:aapms-conflict 供 POST /conflict/context 的 DTO
    -- (Draft / ConflictOpts / ContextHit)。它是上游的型別與純邏輯套件、不是實作端,
    -- 依賴方向與既有的 aapms-service 同一種性質。
    --
    -- llm-workshop-mcp/F004:aapms-workshop 供 WorkshopAPI 的 Session 型別
    -- (POST /workshop 等三條路由的 body/回應)。aapms-llm 供 Session 的
    -- wsHistory 元素型別 Message / Role 的 ToSchema——兩者與 aapms-conflict
    -- 同一種性質:上游的型別套件,不是實作端,servant-server / servant-client /
    -- warp 一個都沒帶進來。這條 build-depends 是 F004 文檔原本沒列出、實作時
    -- 才發現的必要補充(見回報的待確認假設)。
    build-depends:
        , aeson
        , base              >=4.14 && <5
        , http-api-data
        , insert-ordered-containers
        , lens
        , openapi3
        , servant
        , servant-openapi3
        , aapms-conflict
        , aapms-core
        , aapms-llm
        , aapms-service
        , aapms-workshop
        , text
        , time

test-suite aapms-api-test
    import:           warnings, lang
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        Aapms.Api.ApiSpec
        Aapms.Api.CabalSpec
        Aapms.Api.Fixtures
        Aapms.Api.HttpDataSpec
        Aapms.Api.OpenApiSpec
        Aapms.Api.SchemaSpec
    build-depends:
        , aeson
        , base
        , bytestring
        , containers
        , directory
        , hspec
        , http-api-data
        , insert-ordered-containers
        , lens
        , openapi3
        , servant
        , aapms-api
        , aapms-conflict
        , aapms-core
        , aapms-llm
        , aapms-service
        , aapms-workshop
        , text
        , time
