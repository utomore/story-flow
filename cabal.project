-- aapms — 故事設定的片段圖譜與場景樹管理工具
-- GHC 9.14.1 / cabal 3.16.x,不使用 stack。

packages:
  core/
  types/
  md/
  store/
  -- P3:workspace 由 /subsys-build 展開中(見 .design/subsystems/workspace/build-log.md)。
  -- 它只依賴 graph-core,不受下游凍結影響。
  workspace/
  -- contract/ 只建 aapms-contract-rules-test(相依方向的四條硬規則)。它只讀各套件的
  -- .cabal 文字,不跑執行檔,所以不受下游凍結影響;吃執行檔的另外五組由該檔的
  -- `executables` flag 收著,P3 重建 shell 時開啟。見 .design/bugfixes/G-B001-*。
  contract/
  -- P1(graph-core 重建)期間凍結下游:core 型別換成統一 Meta 後下游編不過。
  -- 依 ADR-018 接受 P1–P2 兩邊不完整,P3 重建 service / shell 時依序加回。
  -- 決策見 .design/subsystems/graph-core/build-log.md D1(範圍已由 G-B001 收窄)。
  -- service/ 的舊實作已於 2026-08-30 搬進 legacy/service-and-interfaces/(移植參考,不建置)。
  -- 2026-08-30 起由 /subsys-build service 逐波重建,見 .design/subsystems/service/build-log.md。
  -- 目前只含階段一 W1 的三個模組;exposed-modules 由編排者逐波加入。
  service/
  -- conflict/
  -- llm/
  -- workshop/
  -- cli/
  -- api/
  -- server/
  -- mcp/

-- GHC 9.14 (base-4.22) 仍是新版本,部分套件的 base 上界尚未放寬。
-- 只對確定安全的套件開放,不要全域 allow-newer。
allow-newer:
  , *:base
  , *:template-haskell
  , *:ghc-prim

tests: True

package aapms-core
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-types
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-md
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-store
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-service
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-conflict
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-llm
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-workshop
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-cli
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-api
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-server
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-mcp
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

-- direct-sqlite 預設不編入 FTS5。全文檢索是衝突偵測第 2 層的基礎,
-- 而且 trigram tokenizer(中文搜尋所需)只存在於 FTS5。
package direct-sqlite
  flags: +fulltextsearch

package aapms-contract
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-workspace
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns
