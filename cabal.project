-- aapms — 故事設定的片段圖譜與場景樹管理工具
-- GHC 9.14.1 / cabal 3.16.x,不使用 stack。

packages:
  core/
  types/
  md/
  store/
  service/
  conflict/
  llm/
  workshop/
  cli/
  api/
  server/
  mcp/
  contract/

-- GHC 9.14 (base-4.22) 仍是新版本,部分套件的 base 上界尚未放寬。
-- 只對確定安全的套件開放,不要全域 allow-newer。
allow-newer:
  , *:base
  , *:template-haskell
  , *:ghc-prim

tests: True

package aapms-core
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-types
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-md
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-store
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-service
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-conflict
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-llm
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-workshop
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-cli
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-api
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-server
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

package aapms-mcp
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

-- direct-sqlite 預設不編入 FTS5。全文檢索是衝突偵測第 2 層的基礎,
-- 而且 trigram tokenizer(中文搜尋所需)只存在於 FTS5。
package direct-sqlite
  flags: +fulltextsearch

package aapms-contract
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns
