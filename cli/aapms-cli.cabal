cabal-version:      3.4
name:               aapms-cli
version:            0.1.0.0
synopsis:           aapms 指令(內嵌模式)
license:            BSD-3-Clause
author:             Alchbees Studio
maintainer:         lhm.stu@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat

common lang
    default-language:   GHC2021
    default-extensions:
        DerivingStrategies
        LambdaCase
        OverloadedStrings
        RecordWildCards
        StrictData

library
    import:           warnings, lang
    hs-source-dirs:   src
    exposed-modules:
        Aapms.Cli
        Aapms.Cli.Backend
        Aapms.Cli.Doctor
        Aapms.Cli.Error
        Aapms.Cli.Options
        Aapms.Cli.Render
        Aapms.Cli.Resolve
    -- G-E002:--version 從 cabal 的 version 欄讀,單一來源。
    other-modules:
        Paths_aapms_cli
    autogen-modules:
        Paths_aapms_cli
    -- service-and-interfaces/F002 驗收標準 3:CLI 碰不到落地層,只認得 service。
    -- aapms-store / aapms-md / sqlite-simple / direct-sqlite 出現在這裡
    -- 即為架構違規(service-and-interfaces/F002 T1 的測試會擋下來)。
    --
    -- llm-workshop-mcp/F004:aapms-workshop 供 workshop 三指令呼叫
    -- startWorkshop / loadSession / stepWorkshop / commitStage;aapms-llm
    -- 供 acquireLlmClient 讀 [llm] 設定並建 LlmClient(接線層,不跨 HTTP)。
    build-depends:
        , aeson
        , base                  >=4.14 && <5
        , bytestring
        , containers
        , directory
        , http-client
        , http-types
        , mtl
        , optparse-applicative
        , servant
        , servant-client
        , aapms-api
        , aapms-conflict
        , aapms-core
        , aapms-llm
        , aapms-service
        , aapms-workshop
        , text
        , transformers

executable aapms
    import:           warnings, lang
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:
        , base
        , aapms-cli

test-suite aapms-cli-test
    import:           warnings, lang
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        Aapms.Cli.CabalSpec
        Aapms.Cli.ContextCmdSpec
        Aapms.Cli.EndToEndSpec
        Aapms.Cli.EntityNewSpec
        Aapms.Cli.EntityReadSpec
        Aapms.Cli.EntityWriteSpec
        Aapms.Cli.EnvelopeSpec
        Aapms.Cli.Fixtures
        Aapms.Cli.LevelCmdSpec
        Aapms.Cli.LinkCmdSpec
        Aapms.Cli.NodeCmdSpec
        Aapms.Cli.OptionsSpec
        Aapms.Cli.ParitySpec
        Aapms.Cli.RemoteCmdSpec
        Aapms.Cli.RemoteOptSpec
        Aapms.Cli.RemoteResolveSpec
        Aapms.Cli.RenderSpec
        Aapms.Cli.ResolveSpec
        Aapms.Cli.RunCliSpec
        Aapms.Cli.TreeSpec
        Aapms.Cli.VaultCmdSpec
        Aapms.Cli.WorkshopCmdSpec
        Aapms.Cli.DoctorSpec
        Aapms.Cli.ReleaseScriptSpec
        Aapms.Cli.EncodingSpec
    build-depends:
        , aeson
        , base
        , bytestring
        , directory
        , filepath
        , hspec
        , http-types
        , optparse-applicative
        , process
        , aapms-cli
        , aapms-server
        , warp
        , servant
        , servant-client
        , aapms-api
        , aapms-conflict
        , aapms-core
        , aapms-llm
        , aapms-service
        , aapms-workshop
        , temporary
        , text
        , time
        , wai
