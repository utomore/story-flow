cabal-version:      3.4
name:               storyflow-cli
version:            0.1.0.0
synopsis:           story-flow 指令(內嵌模式)
license:            BSD-3-Clause
author:             Alchbees Studio
maintainer:         lhm.stu@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat

common lang
    default-language:   GHC2021
    default-extensions:
        DerivingStrategies
        LambdaCase
        OverloadedStrings
        RecordWildCards
        StrictData

library
    import:           warnings, lang
    hs-source-dirs:   src
    exposed-modules:
        StoryFlow.Cli
        StoryFlow.Cli.Backend
        StoryFlow.Cli.Doctor
        StoryFlow.Cli.Error
        StoryFlow.Cli.Options
        StoryFlow.Cli.Render
        StoryFlow.Cli.Resolve
    -- G-E002:--version 從 cabal 的 version 欄讀,單一來源。
    other-modules:
        Paths_storyflow_cli
    autogen-modules:
        Paths_storyflow_cli
    -- service-and-interfaces/F002 驗收標準 3:CLI 碰不到落地層,只認得 service。
    -- storyflow-store / storyflow-md / sqlite-simple / direct-sqlite 出現在這裡
    -- 即為架構違規(service-and-interfaces/F002 T1 的測試會擋下來)。
    --
    -- llm-workshop-mcp/F004:storyflow-workshop 供 workshop 三指令呼叫
    -- startWorkshop / loadSession / stepWorkshop / commitStage;storyflow-llm
    -- 供 acquireLlmClient 讀 [llm] 設定並建 LlmClient(接線層,不跨 HTTP)。
    build-depends:
        , aeson
        , base                  >=4.14 && <5
        , bytestring
        , containers
        , directory
        , http-client
        , http-types
        , mtl
        , optparse-applicative
        , servant
        , servant-client
        , storyflow-api
        , storyflow-conflict
        , storyflow-core
        , storyflow-llm
        , storyflow-service
        , storyflow-workshop
        , text
        , transformers

executable story-flow
    import:           warnings, lang
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:
        , base
        , storyflow-cli

test-suite storyflow-cli-test
    import:           warnings, lang
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        StoryFlow.Cli.CabalSpec
        StoryFlow.Cli.ContextCmdSpec
        StoryFlow.Cli.EndToEndSpec
        StoryFlow.Cli.EntityNewSpec
        StoryFlow.Cli.EntityReadSpec
        StoryFlow.Cli.EntityWriteSpec
        StoryFlow.Cli.EnvelopeSpec
        StoryFlow.Cli.Fixtures
        StoryFlow.Cli.LevelCmdSpec
        StoryFlow.Cli.LinkCmdSpec
        StoryFlow.Cli.NodeCmdSpec
        StoryFlow.Cli.OptionsSpec
        StoryFlow.Cli.ParitySpec
        StoryFlow.Cli.RemoteCmdSpec
        StoryFlow.Cli.RemoteOptSpec
        StoryFlow.Cli.RemoteResolveSpec
        StoryFlow.Cli.RenderSpec
        StoryFlow.Cli.ResolveSpec
        StoryFlow.Cli.RunCliSpec
        StoryFlow.Cli.TreeSpec
        StoryFlow.Cli.VaultCmdSpec
        StoryFlow.Cli.WorkshopCmdSpec
        StoryFlow.Cli.DoctorSpec
        StoryFlow.Cli.ReleaseScriptSpec
        StoryFlow.Cli.EncodingSpec
    build-depends:
        , aeson
        , base
        , bytestring
        , directory
        , filepath
        , hspec
        , http-types
        , optparse-applicative
        , process
        , storyflow-cli
        , storyflow-server
        , warp
        , servant
        , servant-client
        , storyflow-api
        , storyflow-conflict
        , storyflow-core
        , storyflow-llm
        , storyflow-service
        , storyflow-workshop
        , temporary
        , text
        , time
        , wai
