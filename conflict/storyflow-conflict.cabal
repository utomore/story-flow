cabal-version:      3.4
name:               storyflow-conflict
version:            0.1.0.0
synopsis:           story-flow 衝突偵測的共用資料語彙(型別與編碼,不含偵測邏輯)
license:            BSD-3-Clause
author:             Alchbees Studio
maintainer:         lhm.stu@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat

common lang
    default-language:   GHC2021
    default-extensions:
        DerivingStrategies
        LambdaCase
        OverloadedStrings
        RecordWildCards
        StrictData

library
    import:           warnings, lang
    hs-source-dirs:   src
    exposed-modules:
        StoryFlow.Conflict.Graph
        StoryFlow.Conflict.Json
        StoryFlow.Conflict.Judge
        StoryFlow.Conflict.Pipeline
        StoryFlow.Conflict.Retrieval
        StoryFlow.Conflict.Types
    -- 第 2 層(conflict-detection/F003)起,本套件不再只是型別:@Conflict.Retrieval@
    -- 的存在前提就是 service 已經到位,所以 storyflow-service 在這裡是合法的。
    -- 第 3 層(conflict-detection/F005)起放行 storyflow-llm:@Conflict.Judge@ 消費
    -- llm-workshop-mcp 的 LlmClient / chat,不實作端點。放行的同時剩下三項守得
    -- 更緊 —— storyflow-store / storyflow-md / sqlite-simple 一個都不准進來:
    -- 「所有讀取經 ServiceM」這條子系統界線靠的正是這三個名字不出現。
    build-depends:
        , aeson
        , base              >=4.14 && <5
        , containers
        , mtl
        , storyflow-core
        , storyflow-llm
        , storyflow-service
        , text

test-suite storyflow-conflict-test
    import:           warnings, lang
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        StoryFlow.Conflict.CabalSpec
        StoryFlow.Conflict.EvidenceSpec
        StoryFlow.Conflict.Fixtures
        StoryFlow.Conflict.GraphSpec
        StoryFlow.Conflict.JsonSpec
        StoryFlow.Conflict.JudgeEnvSpec
        StoryFlow.Conflict.JudgeSpec
        StoryFlow.Conflict.MergeSpec
        StoryFlow.Conflict.OptsSpec
        StoryFlow.Conflict.PipelineSpec
        StoryFlow.Conflict.ReportSpec
        StoryFlow.Conflict.RetrievalEnvSpec
        StoryFlow.Conflict.RetrievalSpec
        StoryFlow.Conflict.SortSpec
    -- 整合測試建臨時 Vault __只靠 storyflow-service__:createVault / openEnv /
    -- runService 都在門面上,storyflow-store 一次都不必露臉。
    -- storyflow-llm 是第 3 層測試的假 runner 需要的 LlmClient / Message / Role /
    -- LlmError 型別的來源;測試套件本身不呼叫 newLlmClient、不發任何網路請求
    -- (D6:hermetic)。
    build-depends:
        , aeson
        , base
        , bytestring
        , directory
        , filepath
        , hspec
        , storyflow-conflict
        , storyflow-core
        , storyflow-llm
        , storyflow-service
        , temporary
        , text
        , time
