cabal-version:      3.4
name:               assetdb-ingest
version:            0.1.0.0
synopsis:           Alchbees 資源管理系統 — 掃描與索引
description:
  走訪素材庫、計算內容雜湊、抽取格式專屬中繼資料,寫進資料庫。

license:            BSD-3-Clause
author:             Alchbees Studio
maintainer:         lhm.stu@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat

library
    import:           warnings
    exposed-modules:
        AssetDB.Ingest
        AssetDB.Ingest.Hash
        AssetDB.Ingest.Handler
        AssetDB.Ingest.Scan
        AssetDB.Ingest.Report
    hs-source-dirs:   src
    build-depends:
        , assetdb-archive
        , assetdb-core
        , assetdb-store
        , aeson          >=2.1
        , base           >=4.17 && <5
        , bytestring     >=0.11
        , containers     >=0.6
        , crypton        >=0.34
        , directory      >=1.3
        , filepath       >=1.4
        , JuicyPixels    >=3.3
        , sqlite-simple  >=0.4.18
        , temporary      >=1.3
        , text           >=2.0
        , time           >=1.12
    default-language: GHC2021
    default-extensions:
        DerivingStrategies
        LambdaCase
        OverloadedStrings
        RecordWildCards
        StrictData

test-suite assetdb-ingest-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:
        AssetDB.Ingest.HashSpec
        AssetDB.Ingest.HandlerSpec
        AssetDB.Ingest.ScanSpec
    hs-source-dirs:   test
    build-depends:
        , assetdb-archive
        , assetdb-core
        , assetdb-ingest
        , assetdb-store
        , aeson
        , base
        , bytestring
        , directory
        , filepath
        , hspec          >=2.10
        , JuicyPixels
        , sqlite-simple
        , temporary
        , text
        , zip
    build-tool-depends: hspec-discover:hspec-discover
    default-language: GHC2021
    default-extensions:
        LambdaCase
        OverloadedStrings
        RecordWildCards
