cabal-version:      3.4
name:               storyflow-mcp
version:            0.1.0.0
synopsis:           story-flow 的 MCP stdio adapter(把 REST 的全部 operation 映射成 MCP tools)
license:            BSD-3-Clause
author:             Alchbees Studio
maintainer:         lhm.stu@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat

common lang
    default-language:   GHC2021
    default-extensions:
        DerivingStrategies
        LambdaCase
        OverloadedStrings
        RecordWildCards
        StrictData

library
    import:           warnings, lang
    hs-source-dirs:   src
    exposed-modules:
        StoryFlow.Mcp
        StoryFlow.Mcp.Client
        StoryFlow.Mcp.Config
        StoryFlow.Mcp.Protocol
        StoryFlow.Mcp.Server
        StoryFlow.Mcp.Tools
    -- 「storyflow-mcp 不 import storyflow-service(只打 HTTP)」這條硬性邊界靠的
    -- 正是這幾個名字不出現:storyflow-service / storyflow-store / storyflow-md /
    -- storyflow-conflict / storyflow-workshop / storyflow-llm / storyflow-core 一個
    -- 都不准進來(llm-workshop-mcp/F005 T10 釘住)。servant-client / servant-server /
    -- warp 是另一種違規:tools/call 對 REST 的實際呼叫改用 http-client 原生請求
    -- (查證結果 4),這一層不定義伺服器或用 servant 產生的 client。
    --
    -- 只依賴 storyflow-api(型別,不含實作端):tools 清單完全由編譯期就決定的
    -- storyFlowOpenApi 反推,不連線就能算出 28 個 tools。
    build-depends:
        , aeson
        , base                        >=4.14 && <5
        , bytestring
        , http-client
        , http-types
        , insert-ordered-containers
        , lens
        , openapi3
        , scientific
        , storyflow-api
        , text

executable story-flow-mcp
    import:           warnings, lang
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:
        , base
        , storyflow-mcp
        , text

test-suite storyflow-mcp-test
    import:           warnings, lang
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        StoryFlow.Mcp.CabalSpec
        StoryFlow.Mcp.ClientSpec
        StoryFlow.Mcp.ConfigSpec
        StoryFlow.Mcp.Fixtures
        StoryFlow.Mcp.ProtocolSpec
        StoryFlow.Mcp.ServerSpec
        StoryFlow.Mcp.ToolsSpec
    -- warp stub 模擬 story-flow-serve,與 llm/test/StoryFlow/Llm/Fixtures.hs、
    -- workshop/test/StoryFlow/Workshop/Fixtures.hs 同一個先例。
    build-depends:
        , aeson
        , base
        , bytestring
        , directory
        , hspec
        , http-types
        , insert-ordered-containers
        , lens
        , openapi3
        , storyflow-api
        , storyflow-mcp
        , text
        , wai
        , warp
