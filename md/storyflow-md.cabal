cabal-version:      3.4
name:               storyflow-md
version:            0.1.0.0
synopsis:           story-flow 的 Markdown 分節格式雙向轉換
license:            BSD-3-Clause
author:             Alchbees Studio
maintainer:         lhm.stu@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat

common lang
    default-language:   GHC2021
    default-extensions:
        DerivingStrategies
        LambdaCase
        OverloadedStrings
        RecordWildCards
        StrictData

library
    import:           warnings, lang
    hs-source-dirs:   src
    exposed-modules:
        StoryFlow.Md
        StoryFlow.Md.Document
        StoryFlow.Md.Error
        StoryFlow.Md.Inherit
        StoryFlow.Md.Lexer
        StoryFlow.Md.Parse
        StoryFlow.Md.Render
        StoryFlow.Md.Yaml
    build-depends:
        , aeson
        , base            >=4.14 && <5
        , bytestring
        , containers
        , HsYAML
        , HsYAML-aeson
        , storyflow-core
        , text
        , time

test-suite storyflow-md-test
    import:           warnings, lang
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        StoryFlow.Md.DocumentSpec
        StoryFlow.Md.EditSpec
        StoryFlow.Md.ErrorSpec
        StoryFlow.Md.Fixtures
        StoryFlow.Md.HeadingSpec
        StoryFlow.Md.InheritSpec
        StoryFlow.Md.LexerSpec
        StoryFlow.Md.ParseEntitySpec
        StoryFlow.Md.ParseLevelSpec
        StoryFlow.Md.RenderSpec
        StoryFlow.Md.YamlSpec
        StoryFlow.MdSpec
    build-depends:
        , base
        , containers
        , hspec
        , storyflow-core
        , storyflow-md
        , text
        , time
