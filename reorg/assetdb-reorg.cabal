cabal-version:      3.4
name:               assetdb-reorg
version:            0.1.0.0
synopsis:           Alchbees 資源管理系統 — 素材庫重構
description:
  把舊的手工資料夾結構重整成以 provenance 組織的新結構。
  規劃與執行刻意分開:規劃是純函數,可以在不碰檔案系統的情況下完整測試。

license:            BSD-3-Clause
author:             Alchbees Studio
maintainer:         lhm.stu@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat

library
    import:           warnings
    exposed-modules:
        AssetDB.Reorg.Plan
        AssetDB.Reorg.Snapshot
        AssetDB.Reorg.Render
        AssetDB.Reorg.PackToml
    hs-source-dirs:   src
    build-depends:
        , assetdb-core
        , assetdb-store
        , base           >=4.17 && <5
        , containers     >=0.6
        , filepath       >=1.4
        , sqlite-simple  >=0.4.18
        , text           >=2.0
        , time           >=1.12
    default-language: GHC2021
    default-extensions:
        DerivingStrategies
        LambdaCase
        OverloadedStrings
        RecordWildCards
        StrictData

test-suite assetdb-reorg-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:
        AssetDB.Reorg.PlanSpec
        AssetDB.Reorg.PackTomlSpec
    hs-source-dirs:   test
    build-depends:
        , assetdb-core
        , assetdb-reorg
        , base
        , containers
        , hspec          >=2.10
        , text
    build-tool-depends: hspec-discover:hspec-discover
    default-language: GHC2021
    default-extensions:
        LambdaCase
        OverloadedStrings
        RecordWildCards
