cabal-version:      3.4
name:               aapms-server
version:            0.1.0.0
synopsis:           aapms 的 servant REST 伺服器(綁 loopback)
license:            BSD-3-Clause
author:             Alchbees Studio
maintainer:         lhm.stu@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat

common lang
    default-language:   GHC2021
    default-extensions:
        DataKinds
        DerivingStrategies
        LambdaCase
        OverloadedStrings
        RecordWildCards
        StrictData
        TypeOperators

library
    import:           warnings, lang
    hs-source-dirs:   src
    exposed-modules:
        Aapms.Server
        Aapms.Server.Auth
        Aapms.Server.Error
        Aapms.Server.State
    -- G-E002:--version 從 cabal 的 version 欄讀,單一來源。
    other-modules:
        Paths_aapms_server
    autogen-modules:
        Paths_aapms_server
    -- service-and-interfaces/F003 驗收標準 3:handler 內沒有業務判斷,server 不 import
    -- aapms-store。狀態碼的分派走 service 的 errorCode 字串,不是落地層的
    -- 建構子——aapms-store / sqlite-simple 出現在這裡即為架構違規(T6)。
    --
    -- llm-workshop-mcp/F004:aapms-workshop 供 workshopH 呼叫 startWorkshop /
    -- loadSession / stepWorkshop / commitStage;aapms-llm 供 acquireLlmClient
    -- 讀這個 Vault 綁定的 [llm] 設定並建 LlmClient(接線層,不跨 HTTP)。
    build-depends:
        , aeson
        , base             >=4.14 && <5
        , bytestring
        , directory
        , http-types
        , mtl
        , servant
        , servant-server
        , aapms-api
        , aapms-conflict
        , aapms-core
        , aapms-llm
        , aapms-service
        , aapms-workshop
        , text
        , wai
        , warp

executable aapms-serve
    import:           warnings, lang
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:
        , aeson
        , base
        , bytestring
        , optparse-applicative
        , aapms-api
        , aapms-server
        , text

test-suite aapms-server-test
    import:           warnings, lang
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        Aapms.Server.AuthSpec
        Aapms.Server.CabalSpec
        Aapms.Server.ConcurrencySpec
        Aapms.Server.ErrorMapSpec
        Aapms.Server.Fixtures
        Aapms.Server.HandlerSpec
        Aapms.Server.ServeOptsSpec
        Aapms.Server.WorkshopErrorMapSpec
        Aapms.Server.WorkshopHandlerSpec
    build-depends:
        , aeson
        , async
        , base
        , bytestring
        , directory
        , filepath
        , hspec
        , http-client
        , http-types
        , servant
        , servant-client
        , servant-server
        , aapms-api
        , aapms-conflict
        , aapms-core
        , aapms-llm
        , aapms-server
        , aapms-service
        , aapms-workshop
        , temporary
        , text
        , wai
        , warp
