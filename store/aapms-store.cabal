cabal-version:      3.4
name:               aapms-store
version:            0.1.0.0
synopsis:           aapms 的檔案落地與 SQLite 索引
license:            BSD-3-Clause
author:             Alchbees Studio
maintainer:         lhm.stu@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat

common lang
    default-language:   GHC2021
    default-extensions:
        DerivingStrategies
        LambdaCase
        OverloadedStrings
        RecordWildCards
        StrictData

library
    import:           warnings, lang
    hs-source-dirs:   src
    exposed-modules:
        Aapms.Store
        Aapms.Store.Atomic
        Aapms.Store.Error
        Aapms.Store.Marker
        Aapms.Store.Schema
    build-depends:
        , base          >=4.14 && <5
        , bytestring
        , containers
        , direct-sqlite
        , directory
        , filepath
        , sqlite-simple
        , aapms-core
        , text
        , time
        , toml-reader

test-suite aapms-store-test
    import:           warnings, lang
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        Aapms.Store.AtomicSpec
        Aapms.Store.ErrorSpec
        Aapms.Store.Fixtures
        Aapms.Store.MarkerSpec
        Aapms.Store.SchemaSpec
        Aapms.StoreSpec
    build-depends:
        , base
        , bytestring
        , containers
        , directory
        , filepath
        , hspec
        , sqlite-simple
        , aapms-core
        , aapms-store
        , temporary
        , text
        , time
        , toml-reader
