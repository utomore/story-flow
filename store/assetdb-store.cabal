cabal-version:      3.4
name:               assetdb-store
version:            0.1.0.0
synopsis:           Alchbees 資源管理系統 — SQLite 持久層
description:
  Schema、版本化 migration、連線設定與型別橋接。
  這一層知道 SQL,上面的層不應該知道。

license:            BSD-3-Clause
author:             Alchbees Studio
maintainer:         lhm.stu@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat

library
    import:           warnings
    exposed-modules:
        AssetDB.Store
        AssetDB.Store.Migrate
        AssetDB.Store.Schema
        AssetDB.Store.Orphans
        AssetDB.Store.Tokenize
        AssetDB.Store.Index
        AssetDB.Store.Search
    hs-source-dirs:   src
    build-depends:
        , assetdb-core
        , base          >=4.17 && <5
        , directory     >=1.3
        , filepath      >=1.4
        , sqlite-simple >=0.4.18
        , text          >=2.0
        , time          >=1.12
    default-language: GHC2021
    default-extensions:
        DerivingStrategies
        LambdaCase
        OverloadedStrings
        RecordWildCards

test-suite assetdb-store-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:
        AssetDB.Store.MigrateSpec
        AssetDB.Store.SchemaSpec
        AssetDB.Store.FtsSpec
        AssetDB.Store.TokenizeSpec
        AssetDB.Store.SearchSpec
    hs-source-dirs:   test
    build-depends:
        , assetdb-core
        , assetdb-store
        , base
        , filepath
        , hspec         >=2.10
        , sqlite-simple
        , temporary     >=1.3
        , text
    build-tool-depends: hspec-discover:hspec-discover
    default-language: GHC2021
    default-extensions:
        LambdaCase
        OverloadedStrings
        RecordWildCards
